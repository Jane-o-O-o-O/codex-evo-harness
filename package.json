{
  "name": "codex-trace-viewer",
  "version": "0.1.0",
  "description": "Local-first observability workspace for Codex rollout traces and daily reviews.",
  "author": "Jin Zhangzheng",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jane-o-O-o-O/Make-Codex-Your-Own.git"
  },
  "bugs": {
    "url": "https://github.com/Jane-o-O-o-O/Make-Codex-Your-Own/issues"
  },
  "homepage": "https://github.com/Jane-o-O-o-O/Make-Codex-Your-Own",
  "keywords": [
    "codex",
    "observability",
    "tracing",
    "developer-tools",
    "daily-review"
  ],
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test server.test.mjs insights.test.mjs llm-review.test.mjs trace-detail.test.mjs trace-query.test.mjs agent.test.mjs",
    "desktop": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.jane.codextraceviewer",
    "productName": "Codex Trace Viewer",
    "asar": true,
    "files": [
      "desktop/**/*",
      "public/**/*",
      "server.mjs",
      "insights.mjs",
      "llm-review.mjs",
      "agent-schema.mjs",
      "agent-store.mjs",
      "atomic-file.mjs",
      "trace-query.mjs",
      "harness-tools.mjs",
      "harness-mutations.mjs",
      "agent-engine.mjs",
      "agent-service.mjs",
      "codex-cli.mjs",
      "package.json",
      "ABOUT.md",
      "LICENSE"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Codex Trace Viewer"
    }
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "smol-toml": "^1.8.0"
  }
}
